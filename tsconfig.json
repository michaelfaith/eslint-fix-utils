{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "isolatedDeclarations": true,
    "isolatedModules": true,
    "types": ["estree", "node"]
  },
  "include": ["src", "*.config.ts"]
}
