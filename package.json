{
  "name": "eslint-fix-utils",
  "version": "0.4.3",
  "description": "Utilities for ESLint rule fixers and suggestions. 🧑‍🔧",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelfaith/eslint-fix-utils.git"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "JoshuaKGoldberg",
      "email": "npm@joshuakgoldberg.com",
      "url": "https://joshuakgoldberg.com"
    },
    {
      "name": "michael faith",
      "email": "michaelfaith@users.noreply.github.com",
      "url": "https://michael.faith"
    }
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsdown",
    "format": "prettier .",
    "lint": "eslint . --max-warnings 0",
    "lint:knip": "knip",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.0",
    "@eslint/markdown": "8.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/estree": "1.0.6",
    "@types/node": "24.13.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.2",
    "@vitest/eslint-plugin": "1.6.9",
    "console-fail-test": "0.6.1",
    "eslint": "10.6.0",
    "eslint-plugin-jsdoc": "63.0.0",
    "eslint-plugin-jsonc": "3.3.0",
    "eslint-plugin-n": "18.2.1",
    "eslint-plugin-package-json": "1.5.0",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-regexp": "3.1.0",
    "eslint-plugin-yml": "3.6.0",
    "jiti": "2.7.0",
    "knip": "6.25.0",
    "prettier": "3.9.1",
    "prettier-plugin-curly": "0.4.0",
    "prettier-plugin-packagejson": "3.0.0",
    "prettier-plugin-sh": "0.18.0",
    "pretty-quick": "4.2.2",
    "simple-git-hooks": "2.13.1",
    "tsdown": "0.22.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.2"
  },
  "peerDependencies": {
    "@types/estree": ">=1",
    "eslint": ">=8"
  },
  "peerDependenciesMeta": {
    "@types/estree": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
